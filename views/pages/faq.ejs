<a class="skip-link" href="#main">Skip to content</a>
<%- include('../partials/header') %>

<main id="main">
  <section class="hero ai-hero">
    <div class="container" style="max-width:860px;text-align:center;">
      <nav class="breadcrumb" aria-label="Breadcrumb" style="justify-content:center;"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">FAQ</span></nav>
      <span class="eyebrow">Frequently Asked Questions</span>
      <h1>Answers for SaaS &amp; Ecommerce Leaders</h1>
      <p class="lead">Everything founders, CEOs and growth teams ask us about AI web development, SEO, AEO, GEO, schema markup and dedicated data operations.</p>
      <nav class="faq-jump" aria-label="FAQ topics">
        <% faqGroups.forEach(function (group) { %><a href="#<%= group.id %>"><%= group.title %></a><% }); %>
      </nav>
    </div>
  </section>

  <% faqGroups.forEach(function (group, gi) { %>
  <section class="section<%= gi % 2 === 0 ? ' section--soft' : '' %> faq-group" id="<%= group.id %>" aria-labelledby="<%= group.id %>-title">
    <div class="container">
      <div class="section__head reveal"><h2 id="<%= group.id %>-title"><%= group.title %></h2></div>
      <div class="faq reveal">
        <% group.items.forEach(function (item) { %>
        <div class="faq__item" aria-expanded="false">
          <button class="faq__q" type="button"><%= item.q %><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
          <div class="faq__a"><p><%= item.a %></p></div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% }); %>

  <section class="section cta-band">
    <div class="container cta-band__grid reveal">
      <div class="cta-band__text"><h2>Still Have a Question?</h2><p>Talk to our team. We reply within one business day and can usually answer on a short call.</p></div>
      <div class="cta-band__action"><a href="/contact" class="btn btn--white btn--lg">Book a Free Consultation</a></div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<script src="/script.js?v=<%= assetVersions.script %>" defer></script>

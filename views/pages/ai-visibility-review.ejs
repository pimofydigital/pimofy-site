<%- include('../partials/header') %>

<main id="main">
  <section class="hero ai-hero">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/ai-services">AI Visibility &amp; Growth</a><span aria-hidden="true">/</span><span aria-current="page">AI Visibility Review</span></nav>
        <span class="eyebrow">Free AI Visibility Review</span>
        <h1>Find out if AI recommends your business.</h1>
        <p class="lead">Buyers now ask ChatGPT, Perplexity and Google&rsquo;s AI Overviews who to hire. Our free AI Visibility Review shows whether your business is part of the answer, and what to fix if it isn&rsquo;t.</p>
        <div class="hero__actions">
          <a href="#review-form" class="btn btn--primary btn--lg">Get My Free Review</a>
          <a href="#scorecard" class="btn btn--ghost btn--lg">What&rsquo;s in the Scorecard</a>
        </div>
        <p class="hero__scope">One-page scorecard, delivered within 2 business days. No cost, no obligation.</p>
      </div>
      <div class="hero__media reveal" data-delay="1">
        <div class="ai-panel" aria-hidden="true">
          <div class="ai-panel__head"><span></span><span></span><span></span></div>
          <p class="ai-panel__label">Your AI Visibility Score</p>
          <p class="audit-score"><span class="audit-score__num">__</span><span class="audit-score__of">/ 100</span></p>
          <ul class="ai-panel__list">
            <li>Google Search &amp; AI Overviews</li>
            <li>ChatGPT</li>
            <li>Perplexity</li>
            <li>Google Gemini</li>
            <li>Microsoft Copilot</li>
          </ul>
          <p class="ai-panel__foot">10 buyer questions. 6 engines. 3 fixes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container prose-block text-center reveal">
      <span class="eyebrow">Why It Matters</span>
      <h2>Your buyers are asking AI. Is it naming you?</h2>
      <p class="section__intro">When someone asks an AI assistant for the best provider in your category, it names a short list. If you&rsquo;re not on it, you never get the chance to compete. Most businesses have no idea what AI says about them. The audit tells you.</p>
    </div>
  </section>

  <section class="section" id="scorecard" aria-labelledby="scorecard-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">What You Get</span><h2 id="scorecard-title">What&rsquo;s in Your Scorecard</h2></div>
      <div class="grid grid--3">
        <article class="card card--feature reveal"><h3>Your AI Visibility Score</h3><p>One clear number out of 100, with a band from Invisible to The Answer, so you know exactly where you stand.</p></article>
        <article class="card card--feature reveal" data-delay="1"><h3>Engine-by-Engine Results</h3><p>For 10 real buyer questions: whether you&rsquo;re named, your position and whether your site is cited, across Google, AI Overviews, ChatGPT, Perplexity, Gemini and Copilot.</p></article>
        <article class="card card--feature reveal" data-delay="2"><h3>Who AI Names Instead</h3><p>The competitors that appear most often in your category, and the likely reasons they&rsquo;re ahead of you.</p></article>
        <article class="card card--feature reveal"><h3>Technical Readiness Check</h3><p>AI crawler access, structured data, answer-ready content, reviews and listings, page speed and indexing.</p></article>
        <article class="card card--feature reveal" data-delay="1"><h3>Your Three Highest-Impact Fixes</h3><p>What to do first, each tagged Be Found, Be Cited or Be Chosen, so the next step is clear.</p></article>
        <article class="card card--feature reveal" data-delay="2"><h3>Optional Walkthrough Call</h3><p>A 20-minute call to go through the results and answer your questions. Useful whether or not you work with us.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">How It Works</span><h2>Three Steps, Two Business Days</h2></div>
      <ol class="ai-steps ai-steps--3">
        <li class="ai-step reveal"><span class="ai-step__num">1</span><h3>Tell Us About Your Business</h3><p>About two minutes, using the form below.</p></li>
        <li class="ai-step reveal" data-delay="1"><span class="ai-step__num">2</span><h3>We Run the Review</h3><p>We test your buyer questions across Google and the main AI assistants, and check your site&rsquo;s technical readiness.</p></li>
        <li class="ai-step reveal" data-delay="2"><span class="ai-step__num">3</span><h3>Get Your Scorecard</h3><p>A one-page PDF by email within 2 business days, with an optional call to go through it.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="review-form" aria-labelledby="review-form-title" style="scroll-margin-top:100px;">
    <div class="container audit-form-wrap">
      <div class="card reveal">
        <h2 id="review-form-title" style="font-size:1.6rem;margin-bottom:6px;">Request Your Free AI Visibility Review</h2>
        <p style="color:var(--muted);margin-bottom:20px;">Fields marked * are required. Your scorecard arrives within 2 business days.</p>
        <form class="form" id="contact-form" method="POST" action="/ai-visibility-review" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form__row">
            <div class="field"><label for="name">Full name *</label><input id="name" name="name" type="text" required autocomplete="name" maxlength="80" value="<%= formData.name || '' %>" /></div>
            <div class="field"><label for="email">Work email *</label><input id="email" name="email" type="email" required autocomplete="email" value="<%= formData.email || '' %>" /></div>
          </div>
          <div class="form__row">
            <div class="field"><label for="company">Company name *</label><input id="company" name="company" type="text" required autocomplete="organization" maxlength="120" value="<%= formData.company || '' %>" /></div>
            <div class="field"><label for="website">Website *</label><input id="website" name="website" type="text" inputmode="url" required autocomplete="url" placeholder="example.com" value="<%= formData.website || '' %>" /></div>
          </div>
          <div class="field"><label for="offering">What do you sell? *</label><input id="offering" name="offering" type="text" required maxlength="160" placeholder="e.g. Commercial sound system installation" value="<%= formData.offering || '' %>" /></div>
          <div class="form__row">
            <div class="field"><label for="market">Main market (country and city) *</label><input id="market" name="market" type="text" required maxlength="120" placeholder="e.g. Kenya, Nairobi" value="<%= formData.market || '' %>" /></div>
            <div class="field"><label for="industry">Industry *</label>
              <select id="industry" name="industry" required>
                <option value="">Select&hellip;</option>
                <% ['SaaS','Ecommerce','Professional services','Local business','Non-profit','Other'].forEach(function (opt) { %>
                  <option value="<%= opt %>"<% if (formData.industry === opt) { %> selected<% } %>><%= opt %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <div class="field"><label for="competitors">Up to 3 competitors <span class="form__optional">(optional)</span></label><input id="competitors" name="competitors" type="text" maxlength="300" placeholder="Names or websites, separated by commas" value="<%= formData.competitors || '' %>" /></div>
          <div class="form__row">
            <div class="field"><label for="buyer_question">A question your buyers ask <span class="form__optional">(optional)</span></label><input id="buyer_question" name="buyer_question" type="text" maxlength="200" placeholder="e.g. Who installs sound systems for churches?" value="<%= formData.buyer_question || '' %>" /></div>
            <div class="field"><label for="phone">WhatsApp or phone <span class="form__optional">(optional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" value="<%= formData.phone || '' %>" /></div>
          </div>
          <div class="field" data-human-field>
            <label for="human_verification">Human check: <strong data-human-question><%= humanVerification.question %></strong> = ?</label>
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
              <input id="human_verification" name="human_verification" type="number" inputmode="numeric" min="0" required autocomplete="off" aria-describedby="human-verification-help" style="flex:1 1 220px;" />
              <button type="button" class="btn btn--ghost btn--sm" data-refresh-human-challenge>New challenge</button>
            </div>
            <small id="human-verification-help" class="form__note">Solve the arithmetic question to confirm you are human.</small>
            <div class="field__error" aria-live="polite">Please answer the arithmetic check correctly before submitting.</div>
          </div>
          <div class="field field--check">
            <label class="check-label"><input type="checkbox" name="consent" value="yes" required<% if (formData.consent === 'yes') { %> checked<% } %> /> <span>I agree to Pimofy Digital contacting me about my audit. See our <a href="/privacy">Privacy Policy</a>. *</span></label>
          </div>
          <div id="contact-feedback-anchor" style="scroll-margin-top:120px;"></div>
          <div class="form__feedback" aria-live="polite" tabindex="-1">
            <div class="form__success<% if (auditSuccess) { %> show<% } %>" role="status">Thanks. Your AI Visibility Review is in the queue. You&rsquo;ll get your scorecard by email within 2 business days.</div>
            <% if (errors && errors.length) { %>
              <div class="form__error show">
                <strong>Please fix the following:</strong>
                <ul>
                  <% errors.forEach((err) => { %>
                    <li><%= err.message %></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>
          </div>
          <button type="submit" class="btn btn--primary btn--lg" style="justify-content:center;">Get My Free Review</button>
          <p class="form__note">We only use what&rsquo;s publicly visible. No access to your website or accounts is needed.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="audit-faq-title">
    <div class="container prose-block">
      <div class="section__head reveal"><h2 id="audit-faq-title">Audit FAQs</h2></div>
      <div class="faq reveal">
        <% auditFaqs.forEach(function (item) { %>
        <div class="faq__item" data-open="false">
          <button class="faq__q" type="button"><%= item.q %><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
          <div class="faq__a"><p><%= item.a %></p></div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container cta-band__grid reveal">
      <div class="cta-band__text"><h2>See where you stand in AI search.</h2><p>Free scorecard, delivered within 2 business days.</p></div>
      <div class="cta-band__action"><a href="#review-form" class="btn btn--white btn--lg">Get My Free Review</a></div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<script src="/script.js?v=<%= assetVersions.script %>" defer></script>

  <section class="section cta-band">
    <div class="container cta-band__grid reveal">
      <div class="cta-band__text"><h2>Find Out If AI Recommends You</h2><p>Free, no obligation, and useful whether or not you work with us.</p></div>
      <div class="cta-band__action"><a href="/contact?service=ai-visibility-audit" class="btn btn--white btn--lg">Get Your Free AI Visibility Audit</a></div>
    </div>
  </section>

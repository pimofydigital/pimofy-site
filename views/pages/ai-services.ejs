<a class="skip-link" href="#main">Skip to content</a>
<%- include('../partials/header') %>

<main id="main">
  <section class="hero ai-hero">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">AI Services</span></nav>
        <span class="eyebrow"><%= hub.eyebrow %></span>
        <h1><%= hub.headline %></h1>
        <p class="lead"><%= hub.lead %></p>
        <div class="hero__actions">
          <a href="/contact?service=ai-services" class="btn btn--primary btn--lg">Book a Free AI Visibility Review</a>
          <a href="#services" class="btn btn--ghost btn--lg">Explore Services</a>
        </div>
      </div>
      <div class="hero__media reveal" data-delay="1">
          <div class="ai-panel" aria-hidden="true">
            <div class="ai-panel__head"><span></span><span></span><span></span></div>
            <p class="ai-panel__label">Where your buyers search</p>
            <ul class="ai-panel__list">
              <li>Google Search &amp; AI Overviews</li>
              <li>ChatGPT</li>
              <li>Google Gemini</li>
              <li>Perplexity</li>
              <li>Microsoft Copilot &amp; Bing</li>
              <li>Claude</li>
            </ul>
            <p class="ai-panel__foot">We make sure they find, trust and recommend you.</p>
          </div>
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">Our AI Services</span><h2 id="services-title">Five Services. One Goal: Demand From Search and AI.</h2></div>
      <div class="ai-grid">
        <% services.forEach(function (service, index) { %>
        <article class="card ai-card reveal" data-delay="<%= index % 3 %>">
          <div class="card__icon card__icon--lg"><%- service.icon %></div>
          <h3><a href="/ai-services/<%= service.slug %>"><%= service.name %></a></h3>
          <p><%= service.summary %></p>
          <a class="link" href="/ai-services/<%= service.slug %>" aria-label="Learn more about <%= service.name %>">Learn more &rarr;</a>
        </article>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="why-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">Why Pimofy</span><h2 id="why-title">AI Speed. Human Accountability.</h2></div>
      <div class="grid grid--3">
        <% hub.pillars.forEach(function (pillar, index) { %>
        <div class="card card--feature reveal" data-delay="<%= index %>"><h3><%= pillar.title %></h3><p><%= pillar.text %></p></div>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <div class="section__head reveal"><h2 id="how-title"><%= hub.howTitle %></h2></div>
      <ol class="ai-steps">
        <% hub.how.forEach(function (step, index) { %>
        <li class="ai-step reveal" data-delay="<%= index % 3 %>"><span class="ai-step__num"><%= index + 1 %></span><h3><%= step.title %></h3><p><%= step.text %></p></li>
        <% }); %>
      </ol>
    </div>
  </section>

    <section class="section section--soft" aria-labelledby="faq-title">
      <div class="container">
        <div class="section__head reveal"><span class="eyebrow">FAQ</span><h2 id="faq-title">Frequently Asked Questions</h2></div>
        <div class="faq reveal">
          <% hub.faqs.forEach(function (item) { %>
          <div class="faq__item" aria-expanded="false">
            <button class="faq__q" type="button"><%= item.q %><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
            <div class="faq__a"><p><%= item.a %></p></div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section cta-band">
      <div class="container cta-band__grid reveal">
        <div class="cta-band__text">
          <h2>Ready to Be Found by AI?</h2>
          <p>Get a free AI Visibility Review. We will show how your brand appears in Google and leading AI assistants today, and where the fastest wins are.</p>
        </div>
        <div class="cta-band__action">
          <a href="/contact?service=ai-services" class="btn btn--white btn--lg">Book Your Free AI Visibility Review</a>
        </div>
      </div>
    </section>
</main>

<%- include('../partials/footer') %>
<script src="/script.js?v=<%= assetVersions.script %>" defer></script>

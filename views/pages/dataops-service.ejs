<a class="skip-link" href="#main">Skip to content</a>
<%- include('../partials/header') %>

<main id="main">
  <section class="hero ai-hero">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/data-operations">Data Operations</a><span aria-hidden="true">/</span><span aria-current="page"><%= service.shortName %></span></nav>
        <span class="eyebrow"><%= service.eyebrow %></span>
        <h1><%= service.headline %></h1>
        <p class="lead"><%= service.answer %></p>
        <p><%= service.lead %></p>
        <div class="hero__actions">
          <a href="/capacity-audit" class="btn btn--primary btn--lg">Book Your Free Operations Capacity Audit&trade;</a>
          <a href="#included" class="btn btn--ghost btn--lg">What&rsquo;s Included</a>
        </div>
      </div>
      <div class="hero__media reveal" data-delay="1">
        <div class="ai-outcomes">
          <p class="ai-outcomes__label">Ideal for</p>
          <ul class="checklist">
            <% service.idealFor.forEach(function (item) { %>
            <li><span class="check">&#10003;</span> <%= item %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="problem-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">The Challenge</span><h2 id="problem-title"><%= service.problemTitle %></h2></div>
      <ul class="checklist checklist--2 reveal ai-problems">
        <% service.problems.forEach(function (problem) { %>
        <li><span class="check check--x"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></span> <%= problem %></li>
        <% }); %>
      </ul>
    </div>
  </section>

  <section class="section" id="included" aria-labelledby="included-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">Scope</span><h2 id="included-title">What&rsquo;s Included</h2></div>
      <div class="grid grid--3">
        <% service.included.forEach(function (item, index) { %>
        <article class="card card--feature reveal" data-delay="<%= index % 3 %>"><h3><%= item.title %></h3><p><%= item.text %></p></article>
        <% }); %>
      </div>
      <div class="scope-note reveal">
        <h3>Not included</h3>
        <ul>
          <% service.notIncluded.forEach(function (item) { %><li><%= item %></li><% }); %>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="process-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">Process</span><h2 id="process-title">How It Works</h2></div>
      <ol class="ai-steps">
        <% service.process.forEach(function (step, index) { %>
        <li class="ai-step reveal" data-delay="<%= index % 3 %>"><span class="ai-step__num"><%= index + 1 %></span><h3><%= step.title %></h3><p><%= step.text %></p></li>
        <% }); %>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="quality-title">
    <div class="container">
      <div class="grid grid--2 split-cols">
        <div class="reveal">
          <span class="eyebrow">Quality Assurance</span>
          <h2 id="quality-title">How Quality Is Checked</h2>
          <ul class="checklist">
            <% service.quality.forEach(function (item) { %>
            <li><span class="check">&#10003;</span> <%= item %></li>
            <% }); %>
          </ul>
        </div>
        <div class="card price-card reveal" data-delay="1">
          <span class="eyebrow">Pricing</span>
          <h3>Delivered inside your Data Operations Pod&trade;</h3>
          <ul class="price-list">
            <li><strong>$499</strong> one-time sign-up: process audit, onboarding, SOPs and workflow setup</li>
            <li><strong>$1,600</strong> per specialist per month for 160 dedicated hours</li>
            <li><strong>40-hour trial</strong> during onboarding, deducted from your first invoice</li>
          </ul>
          <p class="price-tools">Your specialist works inside the tools you already use, such as HubSpot, Salesforce or Shopify.</p>
          <a href="/data-operations" class="link">See the full Data Operations Pod&trade; &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="examples-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">Examples</span><h2 id="examples-title">Typical Tasks We Handle</h2></div>
      <div class="grid grid--3">
        <% service.examples.forEach(function (item, index) { %>
        <article class="card card--feature reveal" data-delay="<%= index % 3 %>"><h3><%= item.title %></h3><p><%= item.text %></p></article>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="related-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">Works Even Better Together</span><h2 id="related-title">Related Data Operations Services</h2></div>
      <div class="grid grid--3">
        <% related.forEach(function (item, index) { %>
        <article class="card card--feature reveal" data-delay="<%= index % 3 %>">
          <h3><a href="/data-operations/<%= item.slug %>"><%= item.name %></a></h3>
          <p><%= item.menuTagline %></p>
        </article>
        <% }); %>
      </div>
      <p class="text-center reveal" style="margin-top:24px;">Serving teams in the <a href="/locations/united-kingdom">United Kingdom</a>, <a href="/locations/united-states">United States</a>, <a href="/locations/europe">Europe</a> and <a href="/locations/kenya">Kenya</a>.</p>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="faq-title">
    <div class="container">
      <div class="section__head reveal"><span class="eyebrow">FAQ</span><h2 id="faq-title">Frequently Asked Questions</h2></div>
      <div class="faq reveal">
        <% service.faqs.forEach(function (item) { %>
        <div class="faq__item" data-open="false">
          <button class="faq__q" type="button"><%= item.q %><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
          <div class="faq__a"><p><%= item.a %></p></div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container cta-band__grid reveal">
      <div class="cta-band__text">
        <h2>Find Out What You Could Hand Off</h2>
        <p>The Free Operations Capacity Audit&trade; takes about 30 minutes, has no obligation and shows exactly which <%= service.name.toLowerCase() %> work a dedicated specialist could take on.</p>
      </div>
      <div class="cta-band__action">
        <a href="/capacity-audit" class="btn btn--white btn--lg">Book Your Free Operations Capacity Audit&trade;</a>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<script src="/script.js?v=<%= assetVersions.script %>" defer></script>

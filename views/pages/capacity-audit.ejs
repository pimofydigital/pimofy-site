  <%- include('../partials/header') %>

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__copy reveal">
          <span class="eyebrow">Free &middot; No Obligation</span>
          <h1>Free Operations Capacity Audit&trade;</h1>
          <p class="lead">Find out exactly where your team is losing time to repetitive data work&mdash;in under 30 minutes, at no cost.</p>
          <a href="/contact" class="btn btn--primary btn--lg">Book Your Free Audit</a>
        </div>
        <div class="hero__media reveal" data-delay="1">
          <picture>
            <source srcset="/assets/capacity-donut.webp" type="image/webp" />
            <img src="/assets/capacity-donut.jpg" alt="Donut chart highlighting 68% of team capacity used" width="1024" height="768" fetchpriority="high" decoding="async" />
          </picture>
        </div>
      </div>
    </section>

    <!-- WHO IT'S FOR -->
    <section class="section section--soft">
      <div class="container">
        <div class="section__head reveal"><h2>Who It&rsquo;s For</h2><p>SaaS and Ecommerce companies whose teams spend too much time on repetitive data and operational work.</p></div>
        <div class="grid grid--4 reveal" data-delay="1">
          <div class="card text-center"><span class="check check--blue" style="margin:0 auto 12px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span><h3>Operations Managers</h3></div>
          <div class="card text-center"><span class="check check--blue" style="margin:0 auto 12px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span><h3>Delivery Managers</h3></div>
          <div class="card text-center"><span class="check check--blue" style="margin:0 auto 12px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span><h3>Customer Success Leaders</h3></div>
          <div class="card text-center"><span class="check check--blue" style="margin:0 auto 12px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span><h3>COOs &amp; Founders</h3></div>
        </div>
      </div>
    </section>

    <!-- WHAT WE'LL REVIEW -->
    <section class="section">
      <div class="container">
        <div class="section__head reveal"><h2>What We&rsquo;ll Review</h2></div>
        <div class="grid grid--4 reveal" data-delay="1">
          <div class="review-item"><span class="check check--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span> Current operational workflows</div>
          <div class="review-item"><span class="check check--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span> Data operations processes</div>
          <div class="review-item"><span class="check check--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span> Operational bottlenecks</div>
          <div class="review-item"><span class="check check--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span> Repetitive manual tasks</div>
        </div>
        <div class="grid grid--3 reveal" data-delay="2" style="margin-top:24px;">
          <div class="review-item"><span class="check check--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span> Backlog risks</div>
          <div class="review-item"><span class="check check--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span> Quality management processes</div>
          <div class="review-item"><span class="check check--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></span> Resource allocation &amp; utilization</div>
        </div>
      </div>
    </section>

    <!-- WHAT YOU'LL RECEIVE -->
    <section class="section section--soft">
      <div class="container">
        <div class="section__head reveal"><h2>What You&rsquo;ll Receive</h2></div>
        <div class="grid grid--4">
          <div class="card reveal">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></div>
            <h3>Workflow Assessment</h3><p>A clear review of your current operational processes and the areas creating unnecessary workload.</p>
          </div>
          <div class="card reveal" data-delay="1">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></div>
            <h3>Capacity Analysis</h3><p>Identification of the tasks that can be delegated or streamlined&mdash;with an estimate of the hours you could reclaim each month.</p>
          </div>
          <div class="card reveal" data-delay="2">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg></div>
            <h3>Bottleneck Report</h3><p>A short summary of the operational constraints affecting your delivery speed and quality.</p>
          </div>
          <div class="card reveal" data-delay="3">
            <div class="card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            <h3>Recommended Support Model</h3><p>A practical, no-pressure recommendation for reducing workload&mdash;whether that&rsquo;s with Pimofy or not.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section">
      <div class="container">
        <div class="section__head reveal"><h2>How It Works</h2></div>
        <div class="steps">
          <div class="step reveal">
            <div class="step__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
            <h3>Book a call</h3><p>Pick a 30-minute slot that suits your time zone. We cover UK, EU, and US business hours.</p>
          </div>
          <div class="step reveal" data-delay="1">
            <div class="step__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            <h3>We review together</h3><p>You walk us through your workflows; we listen and ask the right questions.</p>
          </div>
          <div class="step reveal" data-delay="2">
            <div class="step__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg></div>
            <h3>You get your report</h3><p>Within a few business days, with clear, actionable findings. Everything covered by an NDA on request.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- INVESTMENT -->
    <section class="section section--soft">
      <div class="container reveal">
        <div class="invest-free">
          <div class="invest-free__left">
            <span class="invest-free__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
            <div>
              <h2>Investment: Free</h2>
              <p style="margin:0;font-weight:600;color:var(--ink);">No obligation.</p>
            </div>
          </div>
          <div class="invest-free__right">
            <p>The goal is simply to help you understand where operational capacity is being lost&mdash;and whether additional support could create meaningful improvements for your team.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-band">
      <div class="container cta-band__grid reveal">
        <div class="cta-band__text">
          <h2>
            <span class="cta-band__bookicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
            Book Your Free Audit Now
          </h2>
          <p>It takes about 30 minutes and there&rsquo;s no pressure to commit.</p>
        </div>
        <div class="cta-band__action">
          <a href="/contact" class="btn btn--white btn--lg">Book Your Free Capacity Audit&trade;</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/script.js?v=<%= assetVersions.script %>" defer></script>

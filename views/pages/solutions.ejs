  <%- include('../partials/header') %>

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__copy reveal">
          <span class="eyebrow">Solutions</span>
          <h1>One Focused Solution. Built Around Your Data.</h1>
          <p class="lead">We don&rsquo;t sell a menu of services. We run a single, managed Data Operations Pod&trade; that absorbs your repetitive data work&mdash;including the back-office and non-voice support tasks that surround it&mdash;so your core team gets its capacity back.</p>
          <a href="/contact" class="btn btn--primary btn--lg">Book Your Free Capacity Audit&trade;</a>
        </div>
        <div class="hero__media reveal" data-delay="1">
          <picture>
            <source srcset="/assets/data-warehouse.webp" type="image/webp" />
            <img src="/assets/data-warehouse.jpg" alt="Data warehouse architecture: data sources flowing through processing into a central warehouse and analytics" width="1024" height="768" fetchpriority="high" decoding="async" />
          </picture>
        </div>
      </div>
    </section>

    <!-- WHY ONE SOLUTION -->
    <section class="section section--soft">
      <div class="container" style="max-width:820px;">
        <div class="section__head section__head--row reveal">
          <span class="goal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></span>
          <h2>Why One Solution, Not Many</h2>
        </div>
        <p class="text-center reveal" style="font-size:1.1rem;">Most outsourcing providers spread themselves thin across a long service list. We made a deliberate choice to specialize in data operations and do it exceptionally well. That focus is what lets us guarantee 98% quality accuracy, keep a single point of accountability, and onboard only three new clients a month.</p>
      </div>
    </section>

    <!-- EXPLORE -->
    <section class="section">
      <div class="container">
        <div class="section__head reveal"><h2>Explore Our Solution</h2></div>
        <div class="grid grid--2">
          <article class="card card--feature explore-card reveal">
            <div class="card__icon card__icon--lg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"/><path d="M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/></svg></div>
            <h3>The Dedicated Data Operations Pod&trade;</h3>
            <p>A dedicated Data Operations Specialist, backed by QA, SOPs, weekly reporting, and a named account manager. Handles data entry, verification, enrichment, CRM updates, research, database cleanup&mdash;plus the back-office and non-voice support tasks tied to your data.</p>
            <a class="link" href="/data-operations">Explore the Pod &rarr;</a>
          </article>
          <article class="card card--feature explore-card reveal" data-delay="1">
            <div class="card__icon card__icon--lg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
            <h3>Free Operations Capacity Audit&trade;</h3>
            <p>A free, no-obligation review of your workflows. We pinpoint the repetitive tasks worth delegating and show how much capacity your team could reclaim.</p>
            <a class="link" href="/capacity-audit">Book the Audit &rarr;</a>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-band">
      <div class="container cta-band__grid reveal">
        <div class="cta-band__text">
          <h2>
            <span class="cta-band__bookicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
            Not Sure Where to Start?
          </h2>
          <p>Begin with a free Operations Capacity Audit&trade;. We&rsquo;ll show you exactly where your team is losing time&mdash;with no obligation to go further.</p>
        </div>
        <div class="cta-band__action">
          <a href="/contact" class="btn btn--white btn--lg">Book Your Free Capacity Audit&trade;</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/script.js?v=<%= assetVersions.script %>" defer></script>

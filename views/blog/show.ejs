<a class="skip-link" href="#main">Skip to content</a>

<!-- Header / Navigation -->
<%- include('../partials/header') %>

<main id="main">
<article>
  <!-- ARTICLE HERO -->
  <section class="section article-hero">
    <div class="container max-w-820">
      <span class="tag"><%= post.category || 'Uncategorized' %></span>
      <h1><%= post.title %></h1>
      <p class="article-meta">
        By <a href="https://www.linkedin.com/in/moses-njeru-munyi-b02156b2/" rel="author noopener" target="_blank">Moses Njeru Munyi</a> · <%= new Date(post.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %> · <%= readingTime %> min read<% if (showUpdated) { %> · Updated <time datetime="<%= modifiedDate.toISOString() %>"><%= modifiedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></time><% } %>
      </p>
    </div>
  </section>

  <div class="container max-w-900">
    <img class="article-hero__img" src="<%= postImage(post) %>" alt="<%= post.title %>" width="1024" height="576" fetchpriority="high" decoding="async" />
  </div>

  <!-- ARTICLE BODY -->
  <section class="section section--tight-top">
    <div class="container article-body max-w-820">
      <% if (toc && toc.length >= 4) { %>
        <nav class="article-toc" aria-label="On this page">
          <details open>
            <summary>On this page</summary>
            <ol>
              <% toc.forEach(item => { %><li><a href="#<%= item.id %>"><%= item.text %></a></li><% }); %>
            </ol>
          </details>
        </nav>
      <% } %>
      <%- articleHtml %>

      <aside class="author-box" aria-label="About the author">
        <img src="/logo-square.png" alt="Pimofy Digital" width="64" height="64" loading="lazy" decoding="async" />
        <div>
          <p class="author-box__name">Written by <a href="https://www.linkedin.com/in/moses-njeru-munyi-b02156b2/" rel="author noopener" target="_blank">Moses Njeru Munyi</a></p>
          <p class="author-box__role">Co-founder, <a href="/about">Pimofy Digital</a>. Pimofy helps SaaS and ecommerce companies get found on Google and cited by AI assistants, and runs dedicated data operations pods from Nairobi across UK, EU and US hours.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ARTICLE META -->
  <section class="section section--compact">
    <div class="container max-w-820">
      <div class="article-meta-block">
        <p><strong>Tags:</strong></p>
        <div class="actions-row">
          <% if (post.tags && post.tags.length) { %>
            <% post.tags.forEach(tag => { %>
              <a href="/blog/tag/<%= encodeURIComponent(tag) %>" class="tag-link">
                <%= tag %>
              </a>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED ARTICLES -->
  <% if (related && related.length > 0) { %>
    <section class="section section--soft">
      <div class="container">
        <h2 class="section-title-spaced">Related Articles</h2>
        <div class="grid grid--3">
          <% related.forEach((relPost, index) => { %>
            <a class="card article reveal" <% if (index > 0) { %>data-delay="<%= Math.min(index, 2) %>"<% } %> href="/blog/<%= relPost.slug %>">
              <div class="article__thumb">
                <img class="article__img" src="<%= postImage(relPost) %>" alt="<%= relPost.title %>" width="1024" height="576" loading="lazy" decoding="async" />
                <span class="tag tag--overlay"><%= relPost.category || 'Uncategorized' %></span>
              </div>
              <div class="article__body">
                <h3><%= relPost.title %></h3>
                <p><%= relPost.excerpt %></p>
                <span class="link">Read more →</span>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- CTA -->
  <section class="section cta-band">
    <div class="container cta-band__grid reveal">
      <% if (isAiTopic) { %>
      <div class="cta-band__text">
        <h2>Is Your Brand the Answer?</h2>
        <p>Get a free AI Visibility Review and see where you appear on Google, ChatGPT, Gemini and Perplexity, and what to fix first.</p>
      </div>
      <div class="cta-band__action">
        <a href="/ai-visibility-review" class="btn btn--white btn--lg">Get Your Free AI Visibility Review</a>
      </div>
      <% } else { %>
      <div class="cta-band__text">
        <h2>Find Your Real Constraint</h2>
        <p>Book a free Operations Capacity Audit&trade; and we'll show you exactly where your team's time is going.</p>
      </div>
      <div class="cta-band__action">
        <a href="/capacity-audit" class="btn btn--white btn--lg">Book Your Free Operations Capacity Audit&trade;</a>
      </div>
      <% } %>
    </div>
  </section>
</article>
</main>

<!-- Footer -->
<%- include('../partials/footer') %>

<script src="/script.js?v=<%= assetVersions.script %>" defer></script>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <title><%= typeof title !== 'undefined' ? title + ' | Pimofy Digital' : 'Pimofy Digital' %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Data operations and AI growth services for SaaS & Ecommerce companies worldwide' %>" />
    <% if (typeof keywords !== 'undefined') { %><meta name="keywords" content="<%= keywords %>" /><% } %>

    <!-- Canonical URL -->
    <link rel="canonical" href="<%= canonicalUrl || config.app.url %>" />

    <!-- Self-hosted Inter font (no third-party request, no render blocking) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-var.woff2" crossorigin />

    <!-- Stylesheet (content-hashed URL, cached for a year) -->
    <link rel="stylesheet" href="/styles.css?v=<%= assetVersions.styles %>" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link rel="shortcut icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />

    <!-- Preload the LCP image on pages that declare one -->
    <% if (typeof preloadImage !== 'undefined' && preloadImage) { %>
    <link rel="preload" as="image" href="<%= preloadImage %>" type="image/webp" fetchpriority="high" />
    <% } %>

    <!-- Open Graph -->
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Pimofy Digital' %>" />
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Data operations and AI growth services for SaaS & Ecommerce companies worldwide' %>" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= canonicalUrl || config.app.url %>" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Pimofy Digital' %>" />
    <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Data operations and AI growth services for SaaS & Ecommerce companies worldwide' %>" />

    <!-- Organization Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://pimofydigital.com/#business",
      "name": "Pimofy Digital",
      "url": "https://pimofydigital.com",
      "logo": "https://pimofydigital.com/assets/logo.png",
      "email": "info@pimofydigital.com",
      "telephone": "+254722412676",
      "description": "Data operations and AI growth services for SaaS & Ecommerce companies worldwide: dedicated data operations teams, AI web development, SEO, AEO, GEO and schema markup.",
      "address": { "@type": "PostalAddress", "addressLocality": "Nairobi", "addressCountry": "KE" },
      "areaServed": ["United States", "United Kingdom", "Europe", "Canada", "Australia", "Africa", "Worldwide"],
      "knowsAbout": ["SaaS", "Ecommerce", "Data operations", "AI web development", "Search engine optimization", "Answer engine optimization", "Generative engine optimization", "Schema markup"],
      "contactPoint": { "@type": "ContactPoint", "contactType": "sales", "email": "info@pimofydigital.com", "availableLanguage": ["English"] }
    }
    </script>

    <% if (typeof schemaMarkup !== 'undefined' && schemaMarkup) { %>
      <script type="application/ld+json">
        <%- JSON.stringify(schemaMarkup).replace(/</g, '\\u003c') %>
      </script>
    <% } %>
  </head>
  <body>
    <%- include(template) %>
  </body>
</html>

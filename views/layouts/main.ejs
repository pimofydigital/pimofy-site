<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <% const pageTitle = typeof title !== 'undefined' && title ? (/pimofy/i.test(title) ? title : title + ' | Pimofy Digital') : 'Pimofy Digital'; %>
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Pimofy Digital is an AI growth agency that makes your business the answer on Google and in AI search. Nairobi-based, serving the USA, UK, Europe and Africa.' %>" />
    <% if (typeof keywords !== 'undefined') { %><meta name="keywords" content="<%= keywords %>" /><% } %>

    <!-- Canonical URL -->
    <link rel="canonical" href="<%= canonicalUrl || config.app.url %>" />

    <!-- Self-hosted Inter font (no third-party request, no render blocking) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-var.woff2" crossorigin />

    <!-- Stylesheet (content-hashed URL, cached for a year) -->
    <link rel="stylesheet" href="/styles.css?v=<%= assetVersions.styles %>" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link rel="shortcut icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />

    <!-- Preload the LCP image on pages that declare one -->
    <% if (typeof preloadImage !== 'undefined' && preloadImage) { %>
    <link rel="preload" as="image" href="<%= preloadImage %>" type="image/webp" fetchpriority="high" />
    <% } %>

    <!-- Open Graph -->
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Pimofy Digital is an AI growth agency that makes your business the answer on Google and in AI search. Nairobi-based, serving the USA, UK, Europe and Africa.' %>" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= canonicalUrl || config.app.url %>" />
    <% const shareImage = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : ((typeof post !== 'undefined' && post && post.slug) ? postSocialImage(post, config.app.url) : `${String(config.app.url || 'https://pimofydigital.com').replace(/\/$/, '')}/assets/og-image.jpg`); %>
    <meta property="og:site_name" content="Pimofy Digital" />
    <meta property="og:image" content="<%= shareImage %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pimofy Digital: Be the answer, on Google and in AI search." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="<%= shareImage %>" />
    <meta name="twitter:title" content="<%= pageTitle %>" />
    <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Pimofy Digital is an AI growth agency that makes your business the answer on Google and in AI search. Nairobi-based, serving the USA, UK, Europe and Africa.' %>" />

    <!-- Organization Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://pimofydigital.com/#business",
      "name": "Pimofy Digital",
      "url": "https://pimofydigital.com",
      "logo": "https://pimofydigital.com/assets/logo.png",
      "email": "info@pimofydigital.com",
      "telephone": "+254722412676",
      "slogan": "Be the answer, on Google and in AI search.",
      "description": "AI growth agency: AI-powered SEO, AEO, GEO, schema, AI web development, landing pages and Facebook & Instagram ads for any business, plus dedicated data operations for SaaS & Ecommerce. Nairobi-based, serving the USA, UK, Europe and Africa.",
      "address": { "@type": "PostalAddress", "addressLocality": "Nairobi", "addressCountry": "KE" },
      "areaServed": ["United States", "United Kingdom", "Europe", "Africa"],
      "knowsAbout": ["SaaS", "Ecommerce", "AI visibility", "Data operations", "AI web development", "Search engine optimization", "Answer engine optimization", "Generative engine optimization", "Schema markup", "Landing pages", "Facebook and Instagram advertising"],
      "contactPoint": { "@type": "ContactPoint", "contactType": "sales", "email": "info@pimofydigital.com", "availableLanguage": ["English"] }
    }
    </script>

    <% if (typeof schemaMarkup !== 'undefined' && schemaMarkup) { %>
      <script type="application/ld+json">
        <%- JSON.stringify(schemaMarkup).replace(/</g, '\\u003c') %>
      </script>
    <% } %>
  </head>
  <body>
    <%- include(template) %>
  </body>
</html>

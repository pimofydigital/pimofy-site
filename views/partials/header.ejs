<header class="header">
  <% const navCurrentPath = typeof currentPath === 'string' ? currentPath : ''; %>
  <% const navIsAuthenticated = typeof isAuthenticated === 'boolean' ? isAuthenticated : false; %>
  <% const navCsrfToken = typeof csrfToken === 'string' ? csrfToken : ''; %>
  <% const isServicesPath = ['/solutions', '/data-operations', '/capacity-audit'].includes(navCurrentPath) || navCurrentPath.startsWith('/ai-services') || navCurrentPath.startsWith('/data-operations/'); %>
  <div class="container">
    <nav class="nav" aria-label="Primary">
      <a class="nav__logo" href="/" aria-label="Pimofy Digital home">
        <img src="/assets/logo.svg" alt="Pimofy Digital" width="198" height="50" />
      </a>
      <ul class="nav__menu">
        <li><a href="/" <% if (navCurrentPath === '/') { %>aria-current="page"<% } %>>Home</a></li>
        <li class="dropdown dropdown--mega" aria-expanded="false">
          <button class="dropdown__toggle<% if (isServicesPath) { %> is-active<% } %>" type="button" aria-haspopup="true">
            Services
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="dropdown__menu mega">
            <div class="mega__col">
              <p class="mega__heading">AI Visibility &amp; Growth <span class="mega__tag">New</span></p>
              <ul class="mega__stages">
                <li class="mega__stage">Be Found</li>
                <li><a href="/ai-services/ai-seo"><strong>AI-Powered SEO</strong><span>Rank for the searches your customers make</span></a></li>
                <li class="mega__stage">Be Cited</li>
                <li><a href="/ai-services/answer-engine-optimization"><strong>Answer Engine Optimization</strong><span>Become the answer in AI assistants</span></a></li>
                <li><a href="/ai-services/generative-engine-optimization"><strong>Generative Engine Optimization</strong><span>Get recommended by ChatGPT, Gemini &amp; Perplexity</span></a></li>
                <li><a href="/ai-services/schema-markup"><strong>Schema Markup</strong><span>Structured data machines understand</span></a></li>
                <li class="mega__stage">Be Chosen</li>
                <li><a href="/ai-services/ai-web-development"><strong>AI Web Development</strong><span>Fast websites built to convert</span></a></li>
                <li><a href="/ai-services/conversion-landing-pages"><strong>Landing Pages</strong><span>Pages built around one action</span></a></li>
                <li><a href="/ai-services/ai-meta-ads"><strong>Facebook &amp; Instagram Ads</strong><span>Paid social that brings enquiries</span></a></li>
              </ul>
              <a class="mega__all" href="/ai-visibility-review">Free AI Visibility Review &rarr;</a> <a class="mega__all" href="/ai-services">View all &rarr;</a>
            </div>
            <div class="mega__col">
              <p class="mega__heading">Data Operations</p>
              <ul>
                <li><a href="/data-operations"><strong>Data Operations Pod&trade;</strong><span>Dedicated specialist with QA and reporting</span></a></li>
                <li><a href="/capacity-audit"><strong>Free Operations Capacity Audit&trade;</strong><span>For SaaS &amp; Ecommerce operations teams</span></a></li>
                <li><a href="/data-operations/crm-data-management"><strong>CRM Data Management</strong><span>Keep your CRM clean, current and usable</span></a></li>
                <li><a href="/data-operations/data-entry-verification"><strong>Data Entry &amp; Verification</strong><span>Accurate records, keyed and checked</span></a></li>
                <li><a href="/solutions"><strong>Solutions Overview</strong><span>How the pod fits your team</span></a></li>
              </ul>
              <div class="mega__promo">
                <strong>Not sure where to start?</strong>
                <span>Book a free consultation and we will recommend the right service.</span>
                <a href="/contact">Talk to an expert &rarr;</a>
              </div>
            </div>
          </div>
        </li>
        <li><a href="/work" <% if (navCurrentPath === '/work') { %>aria-current="page"<% } %>>Our Work</a></li>
        <li><a href="/industries" <% if (navCurrentPath === '/industries') { %>aria-current="page"<% } %>>Industries</a></li>
        <li><a href="/blog" <% if (navCurrentPath === '/blog' || navCurrentPath.startsWith('/blog/')) { %>aria-current="page"<% } %>>Resources</a></li>
        <li><a href="/about" <% if (navCurrentPath === '/about') { %>aria-current="page"<% } %>>About</a></li>
        <li><a href="/faq" <% if (navCurrentPath === '/faq') { %>aria-current="page"<% } %>>FAQ</a></li>
        <li class="nav__mobile-cta"><a href="/contact" class="btn btn--primary">Book a Call</a></li>
        <% if (navIsAuthenticated) { %>
          <li><a href="/admin">Admin</a></li>
          <li>
            <form method="POST" action="/auth/logout" class="nav__logout-form">
              <input type="hidden" name="_csrf" value="<%= navCsrfToken %>" />
              <button type="submit" class="nav__logout-button">Logout</button>
            </form>
          </li>
        <% } %>
      </ul>
      <div class="nav__actions">
        <a href="/contact" class="btn btn--primary nav__cta">Book a Call</a>
      </div>
      <button class="nav__burger" type="button" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </div>
</header>

<% const tabPath = typeof currentPath === 'string' ? currentPath : ''; %>
<nav class="tabbar" aria-label="Quick navigation">
  <a href="/" class="tabbar__item<% if (tabPath === '/') { %> is-active<% } %>" <% if (tabPath === '/') { %>aria-current="page"<% } %>>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>
    <span>Home</span>
  </a>
  <a href="/solutions" class="tabbar__item<% if (['/solutions','/data-operations','/capacity-audit','/ai-visibility-review'].includes(tabPath) || tabPath.startsWith('/ai-services')) { %> is-active<% } %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
    <span>Services</span>
  </a>
  <a href="/contact" class="tabbar__cta">
    <span class="tabbar__cta-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16.5" rx="2"/><path d="M16 2.5v4M8 2.5v4M3 10h18M12 13.5v4M10 15.5h4"/></svg></span>
    <span>Book a Call</span>
  </a>
  <a href="/work" class="tabbar__item<% if (tabPath === '/work') { %> is-active<% } %>" <% if (tabPath === '/work') { %>aria-current="page"<% } %>>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2.5" y="7" width="19" height="13" rx="2"/><path d="M8.5 7V5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2M2.5 13h19"/></svg>
    <span>Our Work</span>
  </a>
  <button type="button" class="tabbar__item" data-tabbar-menu aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    <span>Menu</span>
  </button>
</nav>
